# Copy to .env for local overrides. These values are development-only.
POSTGRES_DB=linepilot
POSTGRES_USER=linepilot
POSTGRES_PASSWORD=linepilot_dev
APP_PORT=3000
BACKEND_PORT=8080
APP_DEMO_DATA=true
SSE_TIMEOUT_MS=300000
# The desk's local time zone. Token numbers restart at local midnight.
APP_TIME_ZONE=Asia/Kolkata
# "your turn" messages: log (default) or twilio. TWILIO_FROM=whatsapp:+14155238886 sends WhatsApp.
NOTIFY_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
